VITE_SUPABASE_URL=ton_url
VITE_SUPABASE_ANON_KEY=ta_cle_anon

# Feature flag pour suspendre/réactiver l'achat des 5 packs de crédits
# (CreditsPage.tsx) sans toucher au code — ne concerne PAS l'Abonnement
# Marabout ni les abonnements Plans. Fail-SAFE : seule la valeur exacte
# "true" active, absent/"false"/mal défini désactive par défaut. Contrepartie
# backend obligatoire (sinon un client peut contourner le frontend) :
#   supabase secrets set CREDIT_PACKS_ENABLED=true   # ou false
# Rappel : une variable VITE_ est injectée au build, pas lue à l'exécution —
# changer sa valeur sur Vercel nécessite un redeploy pour prendre effet.
VITE_CREDIT_PACKS_ENABLED=

# Cloud Name et API Key Cloudinary : pas des secrets (nécessairement exposés
# côté client pour l'upload widget en mode "unsigned"), d'où le préfixe
# VITE_ sans risque ici.
VITE_CLOUDINARY_CLOUD_NAME=ton_cloud_name
VITE_CLOUDINARY_API_KEY=ta_cle_api

# Préparation pour une future intégration CinetPay (paiement en ligne).
# Pas encore utilisées dans le code actuel.
VITE_CINETPAY_SITE_ID=
VITE_CINETPAY_API_KEY=

# GEMINI_API_KEY n'est PAS une variable client (pas de préfixe VITE_ —
# volontairement absent ici). C'est un secret partagé par deux Edge
# Functions : gemini-proxy (proxy pour l'usage interactif côté admin,
# JWT utilisateur requis) et auto-blog (génération autonome d'articles,
# appel direct à l'API Gemini, pas de session utilisateur). Ne JAMAIS la
# préfixer par VITE_ (sinon elle serait à nouveau embarquée dans le
# bundle du navigateur, visible par n'importe quel visiteur). À définir
# avec :
#   supabase secrets set GEMINI_API_KEY=ta_cle

# NOVU_API_KEY : même règle, secret de l'Edge Function
# supabase/functions/novu-proxy. À définir avec :
#   supabase secrets set NOVU_API_KEY=ta_cle

# --- Secrets Cloudinary pour l'upload serveur (supabase/functions/auto-blog) ---
# CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY : mêmes valeurs que leurs
# équivalents VITE_ ci-dessus, dupliquées sans préfixe VITE_ pour
# auto-blog — l'upload widget client (unsigned, preset "blog_images")
# et l'upload signé côté serveur (auto-blog, sans preset) sont deux
# chemins distincts qui partagent juste le même compte Cloudinary.
#   supabase secrets set CLOUDINARY_CLOUD_NAME=... CLOUDINARY_API_KEY=...
#
# CLOUDINARY_API_SECRET : utilisée par auto-blog pour signer l'upload
# serveur (SHA-1 de folder+timestamp+secret, voir uploadToCloudinary
# dans ce fichier) — nécessaire ici car un upload serveur ne peut pas
# passer par le preset "unsigned" réservé au widget client. Reste aussi
# utile ponctuellement pour l'API Admin Cloudinary. Ne JAMAIS la
# préfixer par VITE_.
#   supabase secrets set CLOUDINARY_API_SECRET=...

# AUTO_BLOG_CRON_SECRET : secret dédié qui authentifie les appels pg_cron
# → auto-blog (voir migration 0016 et supabase/functions/auto-blog) —
# PAS la clé service_role, pour limiter le risque si ce secret fuit
# (celui-ci ne permet de déclencher qu'auto-blog, rien d'autre). Généré
# aléatoirement (ex: openssl rand -hex 32), doit avoir EXACTEMENT la même
# valeur ici et dans private.pipeline_secrets (table créée par la
# migration 0016, faute de Vault/ALTER DATABASE disponibles sur le plan
# gratuit) :
#   supabase secrets set AUTO_BLOG_CRON_SECRET=...
#   insert into private.pipeline_secrets (name, value)
#     values ('auto_blog_cron_secret', '...')
#     on conflict (name) do update set value = excluded.value;
